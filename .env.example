# TASK-001 runs locally without credentials.
# For deployment, use Alchemy login or set Cloudflare credentials in this file.
# ALCHEMY_PASSWORD encrypts local Alchemy state. Set it before deploying.
ALCHEMY_PASSWORD=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Used in subsequent AI/database tasks. Keep these server-side.
OPENAI_API_KEY=
EXTRACT_MODEL=gpt-5.4-mini
DATABASE_URL=

# Optional override for the local Worker connection to Docker.
LOCAL_EVIDENCE_DATABASE_URL=
# Direct Neon PostgreSQL URL for the deployed Hyperdrive origin.
HYPERDRIVE_ORIGIN=
# Set this when your Alchemy Cloudflare profile has a custom name.
CLOUDFLARE_PROFILE=
# Enable the development evidence routes on a deployed development Worker.
ENABLE_EVIDENCE_DEBUG=false
