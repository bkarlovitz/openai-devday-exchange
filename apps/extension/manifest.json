{
  "manifest_version": 3,
  "name": "Council Check",
  "version": "0.1.0",
  "description": "Check factual claims in selected text against official sources.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["contextMenus", "sidePanel", "storage", "activeTab"],
  "host_permissions": ["https://council-checker-dev.snapnda.workers.dev/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Council Check"
  }
}
