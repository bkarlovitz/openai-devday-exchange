{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "council-checker-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [{ "binding": "SUBMISSIONS", "bucket_name": "council-checker-dev-submissions" }],
  "durable_objects": {
    "bindings": [{ "name": "RUN_COORDINATOR", "class_name": "RunCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunCoordinator"] }],
  "workflows": [
    { "binding": "CHECK_RUN", "name": "council-checker-dev-check-run", "class_name": "CheckRun" },
  ],
}
